# Local development needs none of these: it uses an embedded Postgres and the dev sign-in code.

# Neon Postgres (production, preview). Leave unset locally.
DATABASE_URL=

# The dev AuthProvider's fixed one-time code.
DEV_OTP=482915

# Production refuses to start with the dev sign-in code unless this is set on purpose (synthetic data only).
ALLOW_DEV_OTP=

# Server-side only. Never prefix with VITE_, which would put it in the browser bundle.
SARVAM_API_KEY=

# Hosted database only: create the tables with `npm run db:setup` once. Set this to true only to let every cold start do it.
SETUP_ON_START=

# Optional, build time: a link to your survey. Shows a "Give feedback" button. Set it in Vercel, then redeploy.
VITE_FEEDBACK_URL=
